DATABASE_URL=postgresql+psycopg://user:pass@localhost:5432/promptops
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
OPTIMIZER_MODEL=
AUDITOR_MODEL=
EXECUTOR_MODEL=
LLM_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=2
# Modelos a los que las IAs de requisitos piden JSON forzado (response_format),
# separados por comas. Verificado: sirve con nvidia/nemotron-3-super-120b-a12b;
# con moonshotai/kimi-k3 provoca respuestas vacías, así que no lo incluyas.
LLM_JSON_MODE_MODELS=
# true = JSON forzado para todos los modelos (útil con Ollama local)
LLM_JSON_MODE=
# Modelo que usa el Mejorador de requisitos si OPTIMIZER_MODEL no da una respuesta
# usable (vacía o JSON inválido tras reintentar). Verificado: nvidia/nemotron-3-super-120b-a12b
IMPROVER_FALLBACK_MODEL=

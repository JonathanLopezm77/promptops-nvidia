%%{init: {"theme": "base", "flowchart": {"curve": "basis", "nodeSpacing": 35, "rankSpacing": 60, "padding": 16}, "themeVariables": {"fontSize": "15px", "lineColor": "#475569", "edgeLabelBackground": "#FFFFFF"}}}%%
flowchart TB
    subgraph P["① PROMPT — qué pedimos"]
        direction LR
        PE["🗣️ <b>Prompt Engineering</b><br/>rol, tarea, formato"] -->|"sin estructura se vuelve"| VC["Vibe coding · prompt-driven<br/>rápido, pero no escala"]
        EXP["📌 En el proyecto: 7 prompts<br/>validados con 4 Quality Gates"]
    end

    subgraph C["② CONTEXT — qué sabe el modelo"]
        direction LR
        CE["🧩 <b>Context Engineering</b><br/>datos, reglas, salida de la fase anterior"] -->|"alimenta a"| LLM["🧠 LLM · SLM<br/>local u on-premise · cloud"]
        EXC["📌 Cada fase lee lo aprobado<br/>en /specs, no una conversación"]
    end

    subgraph H["③ HARNESS — cómo actúa"]
        direction LR
        HA["🤖 <b>Harness</b><br/>el entorno donde actúa el agente"] -->|"ejecuta al"| AG["🔁 <b>Agente</b> · agentic loop<br/>planea → actúa → observa"]
        GR["🚧 Guardrails<br/>permisos y límites"] -->|"limitan al"| AG
        AG -->|"delega en"| MA["👥 Subagentes<br/>sistemas multiagente"]
        AG -->|"usa"| TO["🔌 MCP · Skills<br/>AGENTS.md"]
    end

    subgraph S["④ SPECIFICATION — qué se construye"]
        direction LR
        SP["📐 <b>Specification</b><br/>JSON Schema · OpenAPI · Gherkin<br/><i>y contexto de la fase siguiente</i>"] -->|"es la base del"| SDD["📘 <b>SDD</b><br/>la especificación es la fuente de verdad"]
        EXS["📌 specification.json → código y pruebas<br/>con trazabilidad REQ → TEST"]
    end

    subgraph G["⑤ GOVERNANCE — cómo se controla"]
        direction LR
        GOV["🛡️ <b>Gobernanza</b><br/>quién decide y con qué evidencia"] --> QG["✅ <b>Quality Gates</b><br/>tests · linters · análisis estático · CI/CD"]
        QG -->|"decide si avanza"| HITL["👤 <b>Human-in-the-loop</b><br/>aprueba o devuelve"]
        GOV --> OBS["📈 Observabilidad<br/>registra qué hizo cada agente"]
        EXG["📌 Un modelo reescribió su sello de<br/>aprobación: el verificador lo detectó"]
    end

    P ==>|"un prompt solo no basta: el modelo necesita contexto"| C
    C ==>|"con contexto, el modelo ya puede actuar"| H
    H ==>|"actuar sin contrato produce deriva"| S
    S <==>|"se verifica si se cumple ⇄ los cambios aprobados vuelven por la especificación"| G
    VC ~~~ EXP
    LLM ~~~ EXC
    SDD ~~~ EXS
    HITL ~~~ EXG

